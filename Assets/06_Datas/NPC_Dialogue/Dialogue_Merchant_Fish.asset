  greetings:
  - "\uC5B4\uC11C \uC640~ \uC624\uB298 \uC7A1\uC740 \uBB3C\uACE0\uAE30 \uAD6C\uACBD\uD558\uACE0
    \uAC00"
  - "\uC624, \uC654\uC5B4? \uC624\uB298\uC740 \uC2F1\uC2F1\uD55C \uB188\uB4E4\uC774
    \uB9CE\uC774 \uB4E4\uC5B4\uC654\uC5B4"
  - "\uC654\uAD6C\uB098! \uBB3C\uACE0\uAE30 \uAD6C\uACBD\uC740 \uACF5\uC9DC\uB2C8\uAE4C
    \uC2E4\uCEF7 \uBCF4\uACE0 \uAC00"
  choices:
  - choiceText: "\uAD6C\uB9E4\uD558\uAE30"
    dialogue: "\uBB58 \uC0B4 \uAC70\uC57C? \uCC9C\uCC9C\uD788 \uACE8\uB77C\uBD10"
  - choiceText: "\uD310\uB9E4\uD558\uAE30"
    dialogue: "\uBB58 \uD314 \uAC70\uC57C? \uD55C\uBC88 \uBCF4\uC5EC\uC918"
  - choiceText: "\uCDE8\uC18C\uD558\uAE30"
    dialogue: "\uADF8\uB798\uADF8\uB798, \uD544\uC694\uD560 \uB54C \uB2E4\uC2DC \uCC3E\uC544\uC640"
  byes:
  - "\uC798 \uAC00! \uB2E4\uC74C\uC5D0 \uB610 \uBCF4\uC790\uACE0"
  - "\uACE0\uB9C8\uC6CC~ \n\uB2E4\uC74C\uC5D0\uB3C4 \uD544\uC694\uD55C \uAC70 \uC788\uC73C\uBA74
    \uCC3E\uC544\uC640"
  - "\uC798 \uAC00! \n\uBB3C\uACE0\uAE30 \uD544\uC694\uD558\uBA74 \uC5B8\uC81C\uB4E0
    \uCC3E\uC544\uC640"
