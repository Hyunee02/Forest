  m_Name: Dialogue_Pirate
  m_EditorClassIdentifier: 
  greetings:
  - "\uC5B4\uC11C \uC624\uAC8C, \uB204\uAD6C \n\uC0AC\uB0E5\uC744 \uB5A0\uB0A0 \uC900\uBE44\uB294
    \uB418\uC5B4 \uC788\uB098?"
  - "\uC624\uD638~ \uC0AC\uB0E5\uD558\uAE30 \uB531 \uC88B\uC740 \uB0A0\uC528\uB85C\uAD70
    \n\uC0AC\uB0E5\uD130\uB85C \uAC00\uACA0\uB098?"
  - "\uC624\uD638\uB77C, \uB204\uAD6C\uB2D8\uC774\uAD70! \n\uC0AC\uB0E5\uD130\uAE4C\uC9C0
    \uB370\uB824\uB2E4\uC904\uAE4C?"
  yesDialogue: "\uC88B\uC544, \uADF8\uB7FC \uC0AC\uB0E5\uD130\uB85C \uCD9C\uBC1C\uD558\uC790\uACE0!"
  noDialogue: "\uC54C\uACA0\uB124, \uB2E4\uC74C\uC5D0 \uB610 \uBCF4\uC790\uACE0!"
