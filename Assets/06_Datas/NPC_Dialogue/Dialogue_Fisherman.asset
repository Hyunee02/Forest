  m_Script: {fileID: 11500000, guid: aa350b591f6b1884f9792c5f720f4e98, type: 3}
  m_Name: Dialogue_Fisherman
  m_EditorClassIdentifier: 
  greetings:
  - "\uC654\uAD6C\uB098~ \uC624\uB298\uB3C4 \uB09A\uC2DC\uD558\uB7EC \uC628 \uAC70\uC57C?"
  - "\uC624\uB298 \uB09A\uC2DC\uB294 \uAF64 \uAD1C\uCC2E\uC744 \uAC83 \uAC19\uC544.
    \uD55C\uBC88 \uD574\uBCFC\uB798?"
  - "\uC624, \uC654\uB124? \uB09A\uC2DC\uD558\uB7EC \uC654\uC5B4?"
  choices:
  - choiceText: "\uB09A\uC2DC\uD558\uB294\uBC95"
    dialogue: "- \uB09A\uC2DC\uB300 \uAD6C\uB9E4\n- \uB09A\uC2DC\uD558\uAE30"
  - choiceText: "\uBBF8\uB07C \uAD6C\uB9E4"
    dialogue: "*** \uBBF8\uB07C\uB294 \uC5BC\uB9C8 \uC785\uB2C8\uB2E4"
  - choiceText: "\uCDE8\uC18C\uD558\uAE30"
    dialogue: "\uADF8\uB798\n\uB09A\uC2DC\uC5D0 \uB300\uD574 \uB354 \uC54C\uACE0
      \uC2F6\uC73C\uBA74 \uC5B8\uC81C\uB4E0 \uCC3E\uC544\uC640"
  byes:
  - "\uC798 \uAC00~ \uC5B4\uB5A4 \uBB3C\uACE0\uAE30\uB97C \uC7A1\uC544\uC62C\uC9C0
    \uAE30\uB300\uB418\uB294\uAD6C\uB9CC"
  - "\uACE0\uB9C8\uC6CC\n\uB09A\uC2DC \uC798\uD558\uACE0 \uC624\uB77C\uACE0"
  - "\uB610 \uC640~ \uBB3C\uACE0\uAE30 \uC7A1\uC73C\uBA74 \uB098\uD55C\uD14C\uB3C4
    \uAF2D \uBCF4\uC5EC\uC8FC\uACE0!"
