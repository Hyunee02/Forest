  - choiceText: "\uCDE8\uC18C\uD558\uAE30"
    dialogue: "\uADF8\uB798\uC694~\n\uD544\uC694\uD55C \uAC8C \uC0DD\uAE30\uBA74
      \uB610 \uB4E4\uB7EC\uC8FC\uC138\uC694"
  byes:
  - "\uACE0\uB9C8\uC6CC\uC694~ \n\uB2E4\uC74C\uC5D0 \uB610 \uB4E4\uB7EC\uC8FC\uC138\uC694"
  - "\uC798 \uAC00\uC694~ \n\uC624\uB298\uB3C4 \uC88B\uC740 \uD558\uB8E8 \uBCF4\uB0B4\uC138\uC694"
  - "\uC624\uB298\uB3C4 \uCC3E\uC544\uC640\uC918\uC11C \uACE0\uB9C8\uC6CC\uC694"
